<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
  <application android:extractNativeLibs="true" tools:replace="android:extractNativeLibs">
    <service
      android:name="com.cicy.mobile.code.CicyCodeService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Runs the user's local CiCy agent API while the mobile client is active."/>
    </service>
    <service
      android:name="com.cicy.mobile.code.CicyAccessibilityService"
      android:exported="true"
      android:label="CiCy Mobile Agent"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/cicy_accessibility_service"/>
    </service>
  </application>
</manifest>
